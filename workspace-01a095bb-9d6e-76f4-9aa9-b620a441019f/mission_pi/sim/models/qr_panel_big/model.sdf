<?xml version="1.0"?>
<!--
  Big QR panel (2x A3 linear: 594 x 840 mm, lying flat) for first
  closed-loop Gazebo runs. The classical bench detector needs the code
  ~80+ px in frame to decode; true A3 from 15 m is only ~26 px, so the
  honest A3 panel (sim/gazebo_qr_panel) waits for the YOLO model while
  this one proves the full loop today. Same texture ratio as A3 — reuse
  the same PNG (make_qr_panel.py, text MISSION-QR-001, out
  sim/models/qr_panel_big/materials/textures/qr.png).
-->
<sdf version="1.9">
  <model name="qr_panel_big">
    <static>true</static>
    <link name="panel">
      <pose>0 0 0.004 0 0 0</pose>
      <visual name="face">
        <geometry>
          <box><size>0.594 0.84 0.008</size></box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://qr_panel_big/materials/textures/qr.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="surface">
        <geometry>
          <box><size>0.594 0.84 0.008</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
