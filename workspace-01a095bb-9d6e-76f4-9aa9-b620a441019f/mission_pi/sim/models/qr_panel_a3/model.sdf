<?xml version="1.0"?>
<!--
  A3 QR panel TRIPLE SIZE (1782 x 2520 mm, 6x A3 linear, 3x previous double, lying flat).
  User fix 2026-09-17: "double triple the size btw it's small" — was 594x840 2x-A3, now 1782x2520 6x-A3.
  Texture is read from model://qr_panel_a3/materials/textures/qr.png — full-A3 QR 95% fill, QR IS entire panel.
  Triple size = ~204px @15m vs 34px original A3, huge and easy to see in Gazebo, YOLO + classical both work.
-->
<sdf version="1.9">
  <model name="qr_panel_a3">
    <static>true</static>
    <link name="panel">
      <pose>0 0 0.01 0 0 0</pose>
      <visual name="face">
        <geometry>
          <box><size>1.782 2.52 0.02</size></box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://qr_panel_a3/materials/textures/qr.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="surface">
        <geometry>
          <box><size>1.782 2.52 0.02</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
