<?xml version="1.0"?>
<!--
  A3 QR panel (297 x 420 mm, lying flat) for Gazebo Harmonic + ogre2.
  Texture is read from model://qr_panel_a3/materials/textures/qr.png —
  generate it with tools/make_qr_panel.py (out
  sim/models/qr_panel_a3/materials/textures/qr.png).
-->
<sdf version="1.9">
  <model name="qr_panel_a3">
    <static>true</static>
    <link name="panel">
      <pose>0 0 0.003 0 0 0</pose>
      <visual name="face">
        <geometry>
          <box><size>0.297 0.42 0.006</size></box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://qr_panel_a3/materials/textures/qr.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="surface">
        <geometry>
          <box><size>0.297 0.42 0.006</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
